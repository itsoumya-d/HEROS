{
  "name": "heros",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "heros",
      "workspaces": [
        "packages/agentic",
        "packages/mcp",
        "examples/agentic-site"
      ]
    },
    "examples/agentic-site": {
      "name": "@soumyadebnath1619/agentic-site-example"
    },
    "node_modules/@soumyadebnath1619/agentic": {
      "resolved": "packages/agentic",
      "link": true
    },
    "node_modules/@soumyadebnath1619/agentic-site-example": {
      "resolved": "examples/agentic-site",
      "link": true
    },
    "node_modules/@soumyadebnath1619/mcp": {
      "resolved": "packages/mcp",
      "link": true
    },
    "packages/agentic": {
      "name": "@soumyadebnath1619/agentic",
      "version": "0.3.0",
      "license": "MIT",
      "bin": {
        "heros-agentic": "bin/heros-agentic.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/mcp": {
      "name": "@soumyadebnath1619/mcp",
      "version": "0.3.0",
      "license": "MIT",
      "bin": {
        "heros-mcp": "bin/heros-mcp.mjs"
      },
      "engines": {
        "node": ">=22"
      }
    }
  }
}
