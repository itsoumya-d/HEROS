{"id": "RX-01", "description": "minimal valid spec", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tree": {"type": "text", "value": "hello"}}}, "expect": {"status": "ok", "valid": true}}
{"id": "RX-02", "description": "missing spec flag", "tool": "remix_render", "arguments": {}, "expect": {"error_code": "MISSING_FLAG"}}
{"id": "RX-03", "description": "wrong schema string", "tool": "remix_render", "arguments": {"spec": {"schema": "nope", "tree": {"type": "text", "value": "x"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-04", "description": "component type outside closed catalog", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tree": {"type": "webview", "value": "x"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-05", "description": "control char in rendered text", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tree": {"type": "text", "value": "a\u0007b"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-06", "description": "non-ASCII in button label", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "actions": {"a1": {"type": "dismiss"}}, "tree": {"type": "button", "label": "caf\u00e9", "onTap": "a1"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-07", "description": "oversized rendered string (>512)", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tree": {"type": "text", "value": ""}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-08", "description": "image source not https", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tree": {"type": "image", "source": "http://x.test/y", "alt": "a"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-09", "description": "action open_deeplink not https", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "actions": {"a1": {"type": "open_deeplink", "url": "http://x.test/y"}}, "tree": {"type": "button", "label": "go", "onTap": "a1"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-10", "description": "action carries raw android intent field", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "actions": {"a1": {"type": "open_deeplink", "url": "https://cdn.example.com/x", "intent": "android.intent.action.VIEW"}}, "tree": {"type": "button", "label": "go", "onTap": "a1"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-11", "description": "action type outside whitelist", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "actions": {"a1": {"type": "exec", "cmd": "rm -rf /"}}, "tree": {"type": "button", "label": "go", "onTap": "a1"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-12", "description": "onTap references undeclared action id", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tree": {"type": "button", "label": "go", "onTap": "ghost"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-13", "description": "color token not hex/alias", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tokens": {"color": {"primary": {"$type": "color", "$value": "red"}}}, "tree": {"type": "text", "value": "x"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-14", "description": "full valid companion spec (watchlist -> to-do)", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tokens": {"color": {"primary": {"$type": "color", "$value": "#2D6CDF"}, "bg": {"$type": "color", "$value": "#0B0B0F"}}, "spacing": {"md": {"$type": "dimension", "$value": {"value": 16, "unit": "dp"}}}}, "actions": {"act.done": {"type": "mark_done", "target": "item-1"}, "act.open": {"type": "open_deeplink", "url": "https://cdn.example.com/title/1"}}, "tree": {"type": "column", "children": [{"type": "text", "value": "My Watchlist To-Do"}, {"type": "card", "children": [{"type": "text", "value": "The Witcher S2"}, {"type": "button", "label": "Mark watched", "onTap": "act.done"}, {"type": "button", "label": "Open", "onTap": "act.open"}]}, {"type": "divider"}, {"type": "spacer"}]}}}, "expect": {"status": "ok", "valid": true}}
{"id": "RX-15", "description": "unknown tool name", "tool": "remix_bogus", "arguments": {}, "expect": {"error_code": "UNKNOWN_TOOL"}}
{"id": "RX-16", "description": "open_deeplink host in allowlist", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "actions": {"a1": {"type": "open_deeplink", "url": "https://maps.example.com/p"}}, "tree": {"type": "button", "label": "map", "onTap": "a1"}}}, "expect": {"status": "ok", "valid": true}}
{"id": "RX-17", "description": "open_deeplink host not in allowlist", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "actions": {"a1": {"type": "open_deeplink", "url": "https://evil.test/p"}}, "tree": {"type": "button", "label": "x", "onTap": "a1"}}}, "expect": {"error_code": "INVALID_SPEC"}}
{"id": "RX-18", "description": "dimension token missing unit is rejected", "tool": "remix_render", "arguments": {"spec": {"schema": "heros.ui/v1", "tokens": {"spacing": {"md": {"$type": "dimension", "$value": {"value": 16}}}}, "tree": {"type": "column", "children": [{"type": "text", "value": "hi"}]}}}, "expect": {"error_code": "INVALID_SPEC"}}
