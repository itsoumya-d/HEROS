{"id":"VA-01","desc":"set a new secret returns ok and version 1","tool":"vault_secret_set","input":{"name":"db-password","value":"s3cr3t!","description":"Database password"},"expect":{"status":"ok","version":1}}
{"id":"VA-02","desc":"set second secret returns ok","tool":"vault_secret_set","input":{"name":"api-key","value":"tok_abc123"},"expect":{"status":"ok","version":1}}
{"id":"VA-03","desc":"get existing secret returns value","tool":"vault_secret_set_then_get","input":{"name":"my-token","value":"hello-world"},"expect":{"status":"ok","value":"hello-world"}}
{"id":"VA-04","desc":"list returns secrets array and count","tool":"vault_secret_list","input":{},"expect":{"status":"ok"}}
{"id":"VA-05","desc":"missing name on set returns MISSING_FLAG","tool":"vault_secret_set","input":{"value":"oops"},"expect":{"error_code":"MISSING_FLAG"}}
{"id":"VA-06","desc":"missing value on set returns MISSING_FLAG","tool":"vault_secret_set","input":{"name":"no-value"},"expect":{"error_code":"MISSING_FLAG"}}
{"id":"VA-07","desc":"missing name on get returns MISSING_FLAG","tool":"vault_secret_get","input":{},"expect":{"error_code":"MISSING_FLAG"}}
{"id":"VA-08","desc":"get non-existent secret returns SECRET_NOT_FOUND","tool":"vault_secret_get","input":{"name":"does-not-exist"},"expect":{"error_code":"SECRET_NOT_FOUND"}}
{"id":"VA-09","desc":"delete non-existent secret returns SECRET_NOT_FOUND","tool":"vault_secret_delete","input":{"name":"ghost-secret"},"expect":{"error_code":"SECRET_NOT_FOUND"}}
{"id":"VA-10","desc":"name with path traversal .. rejected with INVALID_INPUT","tool":"vault_secret_set","input":{"name":"../etc/passwd","value":"x"},"expect":{"error_code":"INVALID_INPUT"}}
{"id":"VA-11","desc":"name with slash rejected with INVALID_INPUT","tool":"vault_secret_set","input":{"name":"foo/bar","value":"x"},"expect":{"error_code":"INVALID_INPUT"}}
{"id":"VA-12","desc":"name with spaces rejected with INVALID_INPUT","tool":"vault_secret_set","input":{"name":"my secret","value":"x"},"expect":{"error_code":"INVALID_INPUT"}}
{"id":"VA-13","desc":"name exactly 128 chars is accepted","tool":"vault_secret_set","input":{"name":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","value":"v"},"expect":{"status":"ok"}}
{"id":"VA-14","desc":"name 129 chars rejected with INVALID_INPUT","tool":"vault_secret_set","input":{"name":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","value":"v"},"expect":{"error_code":"INVALID_INPUT"}}
{"id":"VA-15","desc":"description over 512 chars rejected with INVALID_INPUT","tool":"vault_secret_set","input":{"name":"desc-overflow","value":"v","description":""},"expect":{"error_code":"INVALID_INPUT"}}
{"id":"VA-16","desc":"delete without token returns decision_required and approval_nonce","tool":"vault_secret_delete_pending","input":{"name":"to-be-deleted"},"expect":{"decision_required":true}}
{"id":"VA-17","desc":"delete with invalid token returns INVALID_ACKNOWLEDGMENT_TOKEN","tool":"vault_secret_delete_bad_token","input":{"name":"existing-secret","human_acknowledgment_token":"0000000000000000"},"expect":{"error_code":"INVALID_ACKNOWLEDGMENT_TOKEN"}}
{"id":"VA-18","desc":"delete with malformed token (too short) returns INVALID_ACKNOWLEDGMENT_TOKEN","tool":"vault_secret_delete_bad_token","input":{"name":"existing-secret","human_acknowledgment_token":"abc"},"expect":{"error_code":"INVALID_ACKNOWLEDGMENT_TOKEN"}}
{"id":"VA-19","desc":"set success response contains _rate_limit field","tool":"vault_secret_set","input":{"name":"rate-test","value":"x"},"expect":{"status":"ok"}}
{"id":"VA-20","desc":"list on empty vault returns empty array and count 0","tool":"vault_secret_list","input":{},"expect":{"count":0,"status":"ok"}}
{"id":"VA-21","desc":"secret name with dots and underscores is accepted","tool":"vault_secret_set","input":{"name":"my.secret_name-v2","value":"test"},"expect":{"status":"ok","version":1}}
{"id":"VA-22","desc":"overwrite increments version","tool":"vault_secret_set_overwrite","input":{"name":"versioned","value":"v2"},"expect":{"version":2}}
{"id":"VA-23","desc":"get missing name field returns MISSING_FLAG not INVALID_INPUT","tool":"vault_secret_get","input":{"wrong_field":"x"},"expect":{"error_code":"MISSING_FLAG"}}
{"id":"VA-24","desc":"delete missing name field returns MISSING_FLAG","tool":"vault_secret_delete","input":{},"expect":{"error_code":"MISSING_FLAG"}}
{"id":"VA-25","desc":"name that is only dots (..) rejected","tool":"vault_secret_set","input":{"name":"..","value":"x"},"expect":{"error_code":"INVALID_INPUT"}}
